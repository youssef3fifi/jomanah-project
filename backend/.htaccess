# Enable URL rewriting
RewriteEngine On

# Allow CORS preflight requests
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Route API requests to appropriate files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Medicines endpoints
RewriteRule ^api/medicines/?$ api/medicines.php [L,QSA]
RewriteRule ^api/medicines/([0-9]+)/?$ api/medicines.php [L,QSA]

# Customers endpoints
RewriteRule ^api/customers/?$ api/customers.php [L,QSA]
RewriteRule ^api/customers/([0-9]+)/?$ api/customers.php [L,QSA]

# Sales endpoints
RewriteRule ^api/sales/?$ api/sales.php [L,QSA]
RewriteRule ^api/sales/([0-9]+)/?$ api/sales.php [L,QSA]

# Reports endpoints
RewriteRule ^api/reports/inventory/?$ api/reports.php [L,QSA]
RewriteRule ^api/reports/sales/?$ api/reports.php [L,QSA]
RewriteRule ^api/reports/expiring/?$ api/reports.php [L,QSA]
RewriteRule ^api/reports/dashboard/?$ api/reports.php [L,QSA]

# Error handling
ErrorDocument 404 /index.php
